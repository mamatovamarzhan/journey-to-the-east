# ──────────────────────────────────────────────────────────────────
# Journey to the East — environment variables
# Copy this file to `.env.local` (which is gitignored) and fill in.
# ──────────────────────────────────────────────────────────────────

# Supabase — get these from https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — get a key at https://aistudio.google.com/apikey
# Powers /chat (streaming) and /api/build-tour (structured Tour JSON).
# Make sure the project the key belongs to has the Generative Language API enabled.
GEMINI_API_KEY=

# Resend — for transactional emails (booking confirmations).
# Sign up at https://resend.com → API Keys → "Create API Key".
# `onboarding@resend.dev` is Resend's sandbox sender — works without DNS verification.
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# Telegram Bot — create one via @BotFather on Telegram, copy the token below.
# The username (no @) is shown on the booking screen so users can /start the bot.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Map tiles come from OpenStreetMap — no API key needed. The /map page uses
# Leaflet + OSM, which is free as long as we respect their usage policy.
